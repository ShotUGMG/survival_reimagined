	["Status Effects".Zombification]
		#Allow Zombies to inflict Zombfication
		Zombification = true
		#Allow the Golden Heart to grant the player immunity to Zombification
		"Zombification Immunity" = true
		#Time it takes for Zombification to progress to next stage. Default is 6000 in ticks (5 Minutes)
		"Zombification Time" = 6000.0
		#Chance for a Zombie to inflict Zombification. Default is 0.25 (25%)
		"Zombification Chance" = 0.25

	["Status Effects"."Paranoia/Fear"]
		#Allow the player to feel paranoia/fear if in dark areas
		"Paranoia and Fear" = true
		#Minimum Light Level needed for Darkness effects to take effect (Default is 0, Range: 0 - 15)
		"Darkness Level" = 0.0
		#Minimum Light Level needed for Darkness effects to stop take effect (Default is 5, Range: 0 - 15)
		"Light Level" = 5.0
		#Time in ticks for Paranoia to turn into Fear (Default is 1000 in ticks)
		"Paranoia To Fear Delay" = 1000.0

	["Status Effects"."Binding Sculk"]
		#Binding Sculk applied when walking over Sculk
		"Binding Sculk" = true

	[Events."Blood Moon"]
		#Can Blood Moon happen?
		"Blood Moon" = true
		#Allow Sleeping through Bloodmoon
		"Bloodmoon Sleep" = false
		#Disable Zombies and Skeletons spawns during bloodmoon
		"Disable Normal Mob Spawning" = true

		[Events."Blood Moon"."Blood Moon Spawn Chance"]
			#Full Moon Bloodmoon chance. Defualt is 0.15 (15%)
			"Full Moon Chance" = 0.15
			#Gibbous and Quarter phases chance. Defualt is 0.1 (10%) 
			"Gibbous/Quarter Chance" = 0.1
			#New Moon and crescent phases chance. Defualt is 0.075 (7.5%) 
			"New Moon/Crescent Chance" = 0.075

	[Gameplay."Mechanic Overrides"]
		#Block Breaking Speed. Default is 0.45 (45%) Vanilla is 1 (100%)
		"Block Break Speed" = 0.45

	[Gameplay.Hunger]
		#Disable hunger bar changes (Reverts to vanilla mechanics)
		"Vanilla Hunger" = false
		#Hunger debuffs (Can't jump on 2 drumsticks, slower walk speed on 1 drumstick)
		"Hunger Debuffs" = true
		#Disable Hunger Effect changes (Reverts to Vanilla mechanics)
		"Vanilla Hunger Effect" = false
		#Eating Raw Food gives the player hunger status effect
		"Raw Food" = true
		#Allow meat to spoil
		"Food Spoil" = true

	["Experimental Features".Bleeding]
		#Allow Crimson Arachnid to Inflict Bleeding
		Bleeding = false
		#Chance to contract Bleeding Effect. Defualt is 0.1 (10%)
		bleeding_chance = 0.1
